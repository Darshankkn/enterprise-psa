{
    "_version": "1.65.0",

    "sap.app": {
        "id": "psa.portal",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}"
    },

    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },

    "sap.ui5": {

        "rootView": {
            "viewName": "psa.portal.view.App",
            "type": "XML",
            "async": true,
            "id": "app"
        },

        "dependencies": {
            "minUI5Version": "1.108.0",
            "libs": {
                "sap.ui.core": {},
                "sap.m": {}
            }
        },

        "contentDensities": {
            "compact": true,
            "cozy": true
        },

        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "psa.portal.i18n.i18n"
                }
            }
        },

        "routing": {

            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "viewPath": "psa.portal.view",
                "controlId": "app",
                "controlAggregation": "pages",
                "async": true
            },

            "routes": [
                {
                    "pattern": "",
                    "name": "home",
                    "target": "home"
                },
                {
                    "pattern": "admin",
                    "name": "admin",
                    "target": "admin"
                }
            ],

            "targets": {
                "home": {
                    "viewName": "View1"
                },

                "admin": {
                    "viewName": "Admin"
                }
            }
        }
    }
}