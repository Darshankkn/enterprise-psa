{
  "name": "psa_app",
  "version": "1.0.0",
  "description": "Professional Services Automation CAP Application",
  "license": "ISC",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch:hybrid": "cds watch --profile hybrid",
    "watch-projectmanagement": "cds watch --open projectmanagement/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-timesheetmanagement": "cds watch --open timesheetmanagement/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-invoicemanagement": "cds watch --open invoicemanagement/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-manager": "cds watch --open manager/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-mytimesheet": "cds watch --open psa.employee.mytimesheet/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-employeesmanagement": "cds watch --open employeesmanagement/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-manager-portal": "cds watch --open psa.manager.portal.managerportal/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-portal": "cds watch --open psa.portal.portal/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-project1": "cds watch --open psa.portal.project1/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/hana": "^3.1.2"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/projectmanagement",
    "app/timesheetmanagement",
    "app/invoicemanagement",
    "app/manager",
    "app/employeesmanagement"
  ]
}
